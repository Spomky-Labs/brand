{
  "$description": "Slabs design tokens, brand guidelines v2.0 (October 2026). Format: W3C Design Tokens Community Group. Source: Charte Graphique.pdf.",
  "color": {
    "brand": {
      "anthracite": {
        "$type": "color",
        "$value": "#333334",
        "$description": "Logo, text, dark grounds. CMYK 70 60 55 75. Pantone Black 7 C / Neutral Black U."
      },
      "beton": {
        "$type": "color",
        "$value": "#B3AEA6",
        "$description": "Secondary grounds, rules, text on dark. CMYK 30 25 30 10. Pantone Warm Gray 4 C / Warm Gray 4 U."
      },
      "calcaire": {
        "$type": "color",
        "$value": "#F5F1E8",
        "$description": "Light grounds, logo on dark. CMYK 5 5 10 0. No spot color."
      },
      "orange": {
        "$type": "color",
        "$value": "#ED6A20",
        "$description": "Signal orange: the cursor, the slab, the main action. Never text on light, never a text background, no tint. CMYK 0 70 100 0. Pantone 7578 C / 152 U."
      }
    },
    "complementary": {
      "acier": {
        "$type": "color",
        "$value": "#4A5D6E",
        "$description": "Information, notes, neutral data series. CMYK 60 35 20 55. Small surfaces, always with a word."
      },
      "patine": {
        "$type": "color",
        "$value": "#3E7268",
        "$description": "Success, validation, second data series. CMYK 60 0 40 55."
      },
      "brique": {
        "$type": "color",
        "$value": "#A6452C",
        "$description": "Errors, alerts, negative values. Never a button. CMYK 25 85 95 20."
      }
    },
    "utility": {
      "schiste": {
        "$type": "color",
        "$value": "#5E5B56",
        "$description": "Secondary text, link underline, field borders. CMYK 45 40 40 55 or K 80."
      },
      "calcaire-clair": {
        "$type": "color",
        "$value": "#FBF9F4",
        "$description": "Cards, panels, menus, state notes."
      },
      "calcaire-ombre": {
        "$type": "color",
        "$value": "#ECE7DD",
        "$description": "Notes, tags, inline code, disabled controls."
      },
      "platre": {
        "$type": "color",
        "$value": "#DCD5C6",
        "$description": "Rules on light grounds; types and properties in code."
      },
      "sable": {
        "$type": "color",
        "$value": "#E8C9A8",
        "$description": "Strings and numbers in code on Anthracite only. Screen only."
      }
    },
    "series": {
      "1": {
        "$type": "color",
        "$value": "{color.brand.orange}",
        "$description": "The series the chart is about. One at most."
      },
      "2": {
        "$type": "color",
        "$value": "{color.brand.anthracite}"
      },
      "3": {
        "$type": "color",
        "$value": "{color.complementary.acier}"
      },
      "4": {
        "$type": "color",
        "$value": "{color.complementary.patine}"
      },
      "5": {
        "$type": "color",
        "$value": "{color.utility.schiste}"
      },
      "negative": {
        "$type": "color",
        "$value": "{color.complementary.brique}",
        "$description": "Negative values or alerts only."
      }
    }
  },
  "font": {
    "family": {
